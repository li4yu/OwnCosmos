# Copy to .env.local and fill in values.

# PostgreSQL connection (Neon / Supabase / local)
DATABASE_URL=postgresql://user:password@host:5432/own_cosmos

# Optional Redis（会话热读 / 短缓存 / 限流）。不配则降级直连 Postgres，功能不挡
# 本机示例（D:\Redis · 默认无密码）：
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_KEY_PREFIX=oc:

# Better Auth
# Generate e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Phase 16: Cron 空闲归档（Authorization: Bearer …）；生产必填
# CRON_SECRET=replace-with-a-long-random-string

# Phase 17: 发信（邮箱验证 / 重置密码）。不配 SMTP 时验证码会打印到服务端控制台
# 163 示例：SMTP_HOST=smtp.163.com SMTP_PORT=465 SMTP_SECURE=true
# SMTP_PASS 必须是「客户端授权码」，不是邮箱登录密码；SMTP_FROM 发件地址须与 SMTP_USER 一致
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=自宇 <you@example.com>

# Phase 19: AI / RAG（全局总闸须显式 true；有密钥即可，暂无用户侧开关）
# AI_ENABLED=true
# DASHSCOPE_API_KEY=
# MILVUS_ADDRESS=localhost:19530
# EMBEDDING_MODEL=qwen3.7-text-embedding
# EMBEDDING_DIM=1024
# HYBRID_DENSE_WEIGHT=0.75
# HYBRID_SPARSE_WEIGHT=0.25
# LLM_MODEL=qwen3.8-max
# 本地 Milvus：需 Docker Desktop → docker compose -f docker-compose.milvus.yml up -d
# 手册入库：pnpm rag:import-handbook
# 用户回填：pnpm rag:backfill-user <userId>
